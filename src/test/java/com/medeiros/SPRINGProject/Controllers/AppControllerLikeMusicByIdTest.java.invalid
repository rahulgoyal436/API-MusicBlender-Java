package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.algorithm.algorithmBlender;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.util.Map;

public class AppControllerLikeMusicByIdTest {
    @Mock
    private MusicRepository musicRepo;
    @Mock 
    private LogRepository Log;
    @InjectMocks
    private AppController appController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    void likeMusicWithValidId() {
        // Arrange
        int musicId = 1;
        MusicModel music = new MusicModel();
        music.setNumberOfLikes(5);
        
        when(musicRepo.findById(musicId)).thenReturn(music);
        
        // Act
        String result = appController.LikeMusicById(musicId);
        
        // Assert
        assertEquals(6, music.getNumberOfLikes());
        assertEquals("Música Alterada!", result);
        verify(musicRepo).save(music);
        verify(Log).save(any(LogModel.class));
    }
    @Test
    @Tag("invalid")
    void likeMusicWithNonExistentId() {
        // Arrange
        int invalidId = 999;
        when(musicRepo.findById(invalidId)).thenReturn(null);
        
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            appController.LikeMusicById(invalidId);
        });
    }
    @Test
    @Tag("boundary")
    void likeMusicWithMaxLikes() {
        // Arrange
        int musicId = 1;
        MusicModel music = new MusicModel();
        music.setNumberOfLikes(Integer.MAX_VALUE);
        
        when(musicRepo.findById(musicId)).thenReturn(music);
        
        // Act & Assert
        assertThrows(ArithmeticException.class, () -> {
            appController.LikeMusicById(musicId);
        });
    }
    @Test
    @Tag("integration")
    void likeMusicVerifyLogEntry() {
        // Arrange
        int musicId = 1;
        MusicModel music = new MusicModel();
        music.setNumberOfLikes(10);
        
        when(musicRepo.findById(musicId)).thenReturn(music);
        
        // Act
        appController.LikeMusicById(musicId);
        
        // Assert
        verify(Log).save(argThat(logModel -> 
            logModel.getEndpoint().equals("app/like/{id}") &&
            logModel.getOrigin().equals("App")
        ));
    }
}