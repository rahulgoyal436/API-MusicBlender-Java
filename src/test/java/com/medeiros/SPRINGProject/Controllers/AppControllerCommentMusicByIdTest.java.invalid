package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.algorithm.algorithmBlender;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.util.Map;

@ExtendWith(MockitoExtension.class)
class AppControllerCommentMusicByIdTest {
    @Mock
    private MusicRepository musicRepo;
    @Mock
    private LogRepository Log;
    @Mock
    private LogModel Date;
    @InjectMocks
    private AppController appController;
    private MusicModel testMusic;
    @BeforeEach
    void setUp() {
        testMusic = new MusicModel();
        testMusic.setId(1);
        testMusic.setNumberOfComents(0);
    }
    @Test
    @Tag("valid")
    void successfulCommentIncrement() {
        // Arrange
        when(musicRepo.findById(1)).thenReturn(testMusic);
        when(Date.getTimeNow()).thenReturn("2023-01-01 10:00:00");
        // Act
        String result = appController.CommentMusicById(1);
        // Assert
        assertEquals("Música Alterada!", result);
        assertEquals(1, testMusic.getNumberOfComents());
        verify(musicRepo).save(testMusic);
        verify(Log).save(any(LogModel.class));
    }
    @Test
    @Tag("invalid")
    void commentMusicWithInvalidId() {
        // Arrange
        when(musicRepo.findById(-1)).thenReturn(null);
        // Act & Assert
        assertThrows(NullPointerException.class, () -> 
            appController.CommentMusicById(-1)
        );
        verify(musicRepo, never()).save(any());
    }
    @Test
    @Tag("boundary")
    void commentMusicMaxValue() {
        // Arrange
        testMusic.setNumberOfComents(Integer.MAX_VALUE);
        when(musicRepo.findById(1)).thenReturn(testMusic);
        // Act & Assert
        assertThrows(ArithmeticException.class, () ->
            appController.CommentMusicById(1)
        );
    }
    @Test
    @Tag("integration")
    void verifyLogCreation() {
        // Arrange
        when(musicRepo.findById(1)).thenReturn(testMusic);
        when(Date.getTimeNow()).thenReturn("2023-01-01 10:00:00");
        // Act
        appController.CommentMusicById(1);
        // Assert
        verify(Log).save(argThat(log -> 
            log.getEndpoint().equals("app/comment/{id}") &&
            log.getOrigin().equals("App")
        ));
    }
}