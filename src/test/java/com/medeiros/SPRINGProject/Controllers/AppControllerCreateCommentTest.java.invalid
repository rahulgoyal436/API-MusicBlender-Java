package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.algorithm.algorithmBlender;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.util.Map;

class AppControllerCreateCommentTest {
    @Mock
    private CommentsRepository CommentsRepo;
    @Mock
    private LogRepository Log;
    @Mock
    private LogModel Date;
    @InjectMocks
    private AppController appController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    void createCommentWithValidInput() {
        // Arrange
        int musicId = 1;
        String commentText = "Test Comment";
        String timestamp = "2023-01-01 10:00:00";
        
        when(Date.getTimeNow()).thenReturn(timestamp);
        // Act
        String result = appController.createComment(musicId, commentText);
        // Assert
        verify(CommentsRepo).save(any(CommentsModel.class));
        verify(Log).save(any(LogModel.class));
        assertEquals(commentText, result);
    }
    @Test
    @Tag("invalid")
    void createCommentWithEmptyComment() {
        // Arrange
        int musicId = 1;
        String commentText = "";
        // Act
        String result = appController.createComment(musicId, commentText);
        // Assert
        verify(CommentsRepo).save(any(CommentsModel.class));
        verify(Log).save(any(LogModel.class));
        assertEquals("", result);
    }
    @Test
    @Tag("boundary")
    void createCommentWithZeroMusicId() {
        // Arrange
        int musicId = 0;
        String commentText = "Test Comment";
        
        // Act
        String result = appController.createComment(musicId, commentText);
        // Assert
        verify(CommentsRepo).save(any(CommentsModel.class));
        verify(Log).save(any(LogModel.class));
        assertEquals(commentText, result);
    }
    @Test
    @Tag("integration")
    void createCommentVerifyLogModelCreation() {
        // Arrange
        int musicId = 1;
        String commentText = "Test Comment";
        String timestamp = "2023-01-01 10:00:00";
        
        when(Date.getTimeNow()).thenReturn(timestamp);
        // Act
        appController.createComment(musicId, commentText);
        // Assert
        verify(Log).save(argThat(logModel -> 
            logModel.getEndpoint().equals("app/createComment/{id}") &&
            logModel.getType().equals("App") &&
            logModel.getDate().equals(timestamp)
        ));
    }
}