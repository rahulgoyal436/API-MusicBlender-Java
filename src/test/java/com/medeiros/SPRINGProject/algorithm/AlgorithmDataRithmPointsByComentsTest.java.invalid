package com.medeiros.SPRINGProject.algorithm;import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.*;

public class AlgorithmDataRithmPointsByComentsTest {
    private AlgorithmData createAlgorithmDataWithDefaultValues() {
        AlgorithmData algorithmData = new AlgorithmData();
        algorithmData.setRithmPoints(0);
        algorithmData.setBlack_list(false);
        algorithmData.setBlocked(false);
        return algorithmData;
    }
    @Test
    @Tag("valid")
    public void validCalculationWithPositiveComments() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        int inputComments = 10; // Sample positive integer
        int expectedPoints = 150;
        int result = algorithmData.rithmPointsByComents(inputComments);
        assertEquals((int) expectedPoints, (int) result, "Points should be 150 for 10 comments.");
    }
    @Test
    @Tag("boundary")
    public void zeroCommentsShouldReturnZeroPoints() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        int inputComments = 0; // Zero comments
        int expectedPoints = 0;
        int result = algorithmData.rithmPointsByComents(inputComments);
        assertEquals((int) expectedPoints, (int) result, "Points should be 0 for 0 comments.");
    }
    @Test
    @Tag("invalid")
    public void negativeCommentsShouldReturnNegativePoints() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        int inputComments = -5; // Negative comments
        int expectedPoints = -75;
        int result = algorithmData.rithmPointsByComents(inputComments);
        assertEquals((int) expectedPoints, (int) result, "Points should be -75 for -5 comments.");
    }
    @Test
    @Tag("boundary")
    public void upperBoundaryForIntegerInput() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        int inputComments = Integer.MAX_VALUE; // Max integer value
        long expectedPoints = (long) inputComments * 15;
        long result = (long) algorithmData.rithmPointsByComents(inputComments);
        assertEquals(expectedPoints, result, "Points calculation should handle maximum integer input.");
    }
    @Test
    @Tag("integration")
    public void checkPointsUnaffectedByBlackListStatus() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        algorithmData.setBlack_list(true); // Set blacklist to true
        int inputComments = 10; // Sample positive integer
        int expectedPoints = 150;
        int result = algorithmData.rithmPointsByComents(inputComments);
        assertEquals((int) expectedPoints, (int) result, "Points should be unaffected by blacklist status.");
    }
    @Test
    @Tag("integration")
    public void checkPointsUnaffectedByBlockedStatus() {
        AlgorithmData algorithmData = createAlgorithmDataWithDefaultValues();
        algorithmData.setBlocked(true); // Set blocked to true
        int inputComments = 10; // Sample positive integer
        int expectedPoints = 150;
        int result = algorithmData.rithmPointsByComents(inputComments);
        assertEquals((int) expectedPoints, (int) result, "Points should be unaffected by blocked status.");
    }
}