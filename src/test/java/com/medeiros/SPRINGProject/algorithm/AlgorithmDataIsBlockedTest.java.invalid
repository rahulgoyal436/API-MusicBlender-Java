package com.medeiros.SPRINGProject.algorithm;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class AlgorithmDataIsBlockedTest {
    private AlgorithmData algorithmData;
    @BeforeEach
    void setUp() {
        algorithmData = new AlgorithmData();
    }
    @Test
    @Tag("valid")
    void verifyDefaultBlockedStatus() {
        assertFalse(algorithmData.isBlocked());
    }
    @Test
    @Tag("valid") 
    void verifyBlockedStatusWhenTrue() {
        algorithmData.setBlocked(true);
        assertTrue(algorithmData.isBlocked());
    }
    @Test
    @Tag("valid")
    void verifyBlockedStatusWhenFalse() {
        algorithmData.setBlocked(true);
        algorithmData.setBlocked(false);
        assertFalse(algorithmData.isBlocked());
    }
    @Test
    @Tag("valid")
    void testBlockedStatusToggling() {
        assertFalse(algorithmData.isBlocked());
        algorithmData.setBlocked(true);
        assertTrue(algorithmData.isBlocked());
        algorithmData.setBlocked(false); 
        assertFalse(algorithmData.isBlocked());
    }
    @Test
    @Tag("integration")
    void testBlockedStatusWithBlackList() {
        algorithmData.setBlack_list(true);
        algorithmData.setBlocked(true);
        assertTrue(algorithmData.isBlocked());
        assertTrue(algorithmData.isBlack_list());
    }
}