        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void calculatePointsForMultipleSongs() {
        MusicModel song1 = mock(MusicModel.class);
        when(song1.getMusicName()).thenReturn("Song A");
        when(song1.getNumberOfLikes()).thenReturn(100);
        when(song1.getNumberOfComents()).thenReturn(50);
        MusicModel song2 = mock(MusicModel.class);
        when(song2.getMusicName()).thenReturn("Song B");
        when(song2.getNumberOfLikes()).thenReturn(200);
        when(song2.getNumberOfComents()).thenReturn(30);
        when(AD.rithmPointsByLike(anyInt())).thenReturn(10, 20); // Mocking points calculation for songs
        when(AD.rithmPointsByComents(anyInt())).thenReturn(5, 3); // Mocking points calculation for songs
        Map<String, Integer> result = blender.algorithmCalc(Arrays.asList(song1, song2));
        Map<String, Integer> expected = new HashMap<>();
        expected.put("Song A", 15);
        expected.put("Song B", 23);
        assertEquals(expected, result);
    }
    @Test
    @Tag("boundary")
    public void handleEmptyList() {
        Map<String, Integer> result = blender.algorithmCalc(Collections.emptyList());
        assertTrue(result.isEmpty());
    }
    
    @Test
    @Tag("boundary")
    public void singleSongWithZeroLikesAndComments() {
        MusicModel song = mock(MusicModel.class);
        when(song.getMusicName()).thenReturn("Song Zero");
        when(song.getNumberOfLikes()).thenReturn(0);
        when(song.getNumberOfComents()).thenReturn(0);
        when(AD.rithmPointsByLike(0)).thenReturn(0); // Expect zero points when zero likes
        when(AD.rithmPointsByComents(0)).thenReturn(0); // Expect zero points when zero comments
        Map<String, Integer> result = blender.algorithmCalc(Collections.singletonList(song));
        Map<String, Integer> expected = new HashMap<>();
        expected.put("Song Zero", 0);
        assertEquals(expected, result);
    }
    @Test
    @Tag("invalid")
