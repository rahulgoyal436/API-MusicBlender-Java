        MusicModel song = mock(MusicModel.class);
        when(song.getMusicName()).thenReturn("Negative Song");
        when(song.getNumberOfLikes()).thenReturn(-10);
        when(song.getNumberOfComents()).thenReturn(-5);
        when(AD.rithmPointsByLike(-10)).thenReturn(0); // Mock handling negatives to zero
        when(AD.rithmPointsByComents(-5)).thenReturn(0); // Mock handling negatives to zero
        Map<String, Integer> result = blender.algorithmCalc(Collections.singletonList(song));
        Map<String, Integer> expected = new HashMap<>();
        expected.put("Negative Song", 0);
