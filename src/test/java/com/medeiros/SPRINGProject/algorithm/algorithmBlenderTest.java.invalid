@Test
@Tag("valid")
public void calculatePointsForMultipleMusicModels() {
    MusicModel musicModel1 = mock(MusicModel.class);
    MusicModel musicModel2 = mock(MusicModel.class);
    when(musicModel1.getNumberOfLikes()).thenReturn(10);
    when(musicModel1.getNumberOfComents()).thenReturn(5);
    when(musicModel1.getMusicName()).thenReturn("Song A");
    when(AD.rithmPointsByLike(10)).thenReturn(20);
    when(AD.rithmPointsByComents(5)).thenReturn(10);
    when(musicModel2.getNumberOfLikes()).thenReturn(20);
    when(musicModel2.getNumberOfComents()).thenReturn(10);
    when(musicModel2.getMusicName()).thenReturn("Song B");
    when(AD.rithmPointsByLike(20)).thenReturn(40);
    when(AD.rithmPointsByComents(10)).thenReturn(20);
    Map<String, Integer> result = algorithmBlender.algorithmCalc(Arrays.asList(musicModel1, musicModel2));
    assertEquals(2, result.size());
    assertEquals(30, (int) result.get("Song A"));
    assertEquals(60, (int) result.get("Song B"));
}

