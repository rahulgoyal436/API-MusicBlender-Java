@Test
@Tag("valid")
public void calculatePointsForMultipleSongs() {
    MusicModel song1 = Mockito.mock(MusicModel.class);
    when(song1.getMusicName()).thenReturn("Song1");
    when(song1.getNumberOfLikes()).thenReturn(10);
    when(song1.getNumberOfComents()).thenReturn(5);
    MusicModel song2 = Mockito.mock(MusicModel.class);
    when(song2.getMusicName()).thenReturn("Song2");
    when(song2.getNumberOfLikes()).thenReturn(20);
    when(song2.getNumberOfComents()).thenReturn(3);
    when(rithmPointsByLike(10)).thenReturn(100);
    when(rithmPointsByComents(5)).thenReturn(50);
    when(rithmPointsByLike(20)).thenReturn(200);
    when(rithmPointsByComents(3)).thenReturn(30);
    Map<String, Integer> expectedMap = new HashMap<>();
    expectedMap.put("Song1", 150);
    expectedMap.put("Song2", 230);
    Map<String, Integer> resultMap = algorithmBlender.algorithmCalc(Arrays.asList(song1, song2));
    assertEquals(expectedMap, resultMap);
}

