@Test
@Tag("valid")
public void verifyPointsCalculationLogic() {
    MusicModel music = mock(MusicModel.class);
    when(music.getNumberOfLikes()).thenReturn(15);
    when(music.getNumberOfComents()).thenReturn(10);
    when(music.getMusicName()).thenReturn("Song C");
    when(mockAlgorithmData.rithmPointsByLike(15)).thenReturn(150);
    when(mockAlgorithmData.rithmPointsByComents(10)).thenReturn(150);
    Map<String, Integer> result = algorithmBlender.algorithmCalc(Collections.singletonList(music));
    assertEquals(1, result.size());
    assertEquals((Integer) 300, result.get("Song C"));
}

