@Test
@Tag("valid")
public void calculatePointsForSingleMusicModel() {
    MusicModel musicModel = mock(MusicModel.class);
    when(musicModel.getNumberOfLikes()).thenReturn(10);
    when(musicModel.getNumberOfComents()).thenReturn(5);
    when(musicModel.getMusicName()).thenReturn("Song A");
    when(AD.rithmPointsByLike(10)).thenReturn(20);
    when(AD.rithmPointsByComents(5)).thenReturn(10);
    Map<String, Integer> result = algorithmBlender.algorithmCalc(Collections.singletonList(musicModel));
    assertEquals(1, result.size());
    assertEquals(30, (int) result.get("Song A"));
}

