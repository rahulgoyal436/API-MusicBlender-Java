@Test
@Tag("valid")
public void calculatePointsForSingleMusicItem() {
    MusicModel music = mock(MusicModel.class);
    when(music.getNumberOfLikes()).thenReturn(10);
    when(music.getNumberOfComents()).thenReturn(5);
    when(music.getMusicName()).thenReturn("Song A");
    when(mockAlgorithmData.rithmPointsByLike(10)).thenReturn(100);
    when(mockAlgorithmData.rithmPointsByComents(5)).thenReturn(75);
    Map<String, Integer> result = algorithmBlender.algorithmCalc(Collections.singletonList(music));
    assertEquals(1, result.size());
    assertEquals((Integer) 175, result.get("Song A"));
}

