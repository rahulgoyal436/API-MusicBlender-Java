package com.medeiros.SPRINGProject.algorithm;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class AlgorithmDataIsBlackListTest {
    private AlgorithmData algorithmData;
    @BeforeEach
    void setUp() {
        algorithmData = new AlgorithmData();
    }
    @Test
    @Tag("valid")
    @DisplayName("Verify default black list status is false")
    void verifyDefaultBlackListStatus() {
        assertFalse(algorithmData.isBlack_list());
    }
    @Test
    @Tag("valid") 
    @DisplayName("Verify black list status after setting to true")
    void verifyBlackListStatusWhenTrue() {
        algorithmData.setBlack_list(true);
        assertTrue(algorithmData.isBlack_list());
    }
    @Test
    @Tag("valid")
    @DisplayName("Verify black list status after setting to false") 
    void verifyBlackListStatusWhenFalse() {
        algorithmData.setBlack_list(false);
        assertFalse(algorithmData.isBlack_list());
    }
    @Test
    @Tag("boundary")
    @DisplayName("Verify black list status after multiple toggles")
    void verifyBlackListStatusAfterMultipleToggles() {
        algorithmData.setBlack_list(true);
        assertTrue(algorithmData.isBlack_list());
        
        algorithmData.setBlack_list(false);
        assertFalse(algorithmData.isBlack_list());
        
        algorithmData.setBlack_list(true);
        assertTrue(algorithmData.isBlack_list());
    }
}